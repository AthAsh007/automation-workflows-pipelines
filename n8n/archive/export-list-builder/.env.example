# 08 ICP List Builder - set these on the n8n host, then restart n8n.
# Requires N8N_BLOCK_ENV_ACCESS_IN_NODE=false. See ../_shared/conventions.md.

# Apollo.io - plan tier must include API access
APOLLO_API_KEY=

# Email verifier. Default wiring is NeverBounce v4.
# For ZeroBounce or MillionVerifier, change the URL and body in the verifier node.
VERIFIER_API_KEY=

# Google Sheet that receives the list (the long id in the sheet URL)
LEADS_SHEET_ID=
