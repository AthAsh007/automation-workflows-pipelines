# 10 Deliverability Watchdog

# Smartlead. For Instantly, change the two API nodes - see the node notes.
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=

# Sheet with a Deliverability tab
LEADS_SHEET_ID=

# Whether the workflow pauses the campaign itself, or only reports.
# Agree this with the client in writing.
AUTO_PAUSE=true

# Thresholds, in percent
BOUNCE_WARN_PCT=3
BOUNCE_STOP_PCT=5
REPLY_FLOOR_PCT=1
UNSUB_WARN_PCT=1

# Below this many sends, rates are noise and the workflow says "too early"
MIN_SAMPLE=100

# Where the daily report goes
ALERT_WEBHOOK_URL=
