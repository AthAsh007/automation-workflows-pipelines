# 03 Reply Triage and Booking

# Classifier

# LLM via the 9router gateway (OpenAI-compatible: /v1/chat/completions, Bearer auth).
# Only modelark/seed-2-0-pro-260328 responds on this key - every Claude route on the
# router returns 403 (Cloudflare) or 402 (no credits). Verified 2026-08-20.
LLM_BASE_URL=https://llm.acme.example
LLM_API_KEY=
LLM_MODEL=modelark/seed-2-0-pro-260328
LLM_MODEL_WRITER=modelark/seed-2-0-pro-260328

# GoHighLevel - Private Integration token with contacts + opportunities scopes
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# Optional deal value stamped on new opportunities
DEFAULT_DEAL_VALUE=0

# Calendar link sent to interested replies
BOOKING_LINK=https://cal.com/your-handle/intro

# Sheet holding the Suppression and Followups tabs (same sheet as templates 01 and 04)
LEADS_SHEET_ID=

# Slack or Discord incoming webhook for reply alerts
ALERT_WEBHOOK_URL=
