# 13 Multichannel Cadence

# Sheet with Leads, Email Queue, LinkedIn Tasks and Call Tasks tabs
LEADS_SHEET_ID=

# Override the default six-touch cadence. Business days, weekends never counted.
# CADENCE_JSON=[{"day":0,"channel":"email","action":"opener"},{"day":3,"channel":"linkedin","action":"connect"},{"day":7,"channel":"email","action":"break_up"}]

# One cap per channel. LinkedIn is clamped to 25 in code regardless of this value.
DAILY_SEND_CAP=80
LI_DAILY_CAP=20
DAILY_CALL_CAP=15

# Email touches below this enrichment confidence are skipped
MIN_CONFIDENCE=70

# Where the daily cadence summary goes
ALERT_WEBHOOK_URL=
