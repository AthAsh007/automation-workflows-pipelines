# 02 Clay to GHL CRM Sync

# GoHighLevel - Private Integration token with contacts scope
GHL_API_TOKEN=
GHL_LOCATION_ID=

# JSON map of GHL custom field id -> our lead field name.
# Get ids from GHL Settings > Custom Fields.
GHL_CUSTOM_FIELD_MAP={"REPLACE_FIELD_ID":"fit_score"}

# Which lead stages are allowed to reach the CRM
SYNC_STAGES=enriched,queued,sent,replied,booked

# The lead sheet
LEADS_SHEET_ID=

# Slack or Discord webhook. Only used when a sync fails.
ALERT_WEBHOOK_URL=
