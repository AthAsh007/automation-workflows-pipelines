# 04 Outbound System Orchestrator

# n8n itself, for the stall check. Without these the scorecard still runs, minus stalls.
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=

# Label -> workflow id. Get ids from each workflow's URL in n8n.
PIPELINE_WORKFLOW_IDS={"08 list build":"REPLACE","14 enrichment":"REPLACE","12 sender":"REPLACE","03 replies":"REPLACE"}

# The lead sheet
LEADS_SHEET_ID=

# Thresholds
DAILY_SEND_CAP=80
MIN_CONFIDENCE=70
MIN_RUNWAY_DAYS=5
REPLY_SLA_HOURS=24

# Daily digest channel
ALERT_WEBHOOK_URL=

# Escalation channel. Must be one someone has notifications on for.
PAGER_WEBHOOK_URL=
