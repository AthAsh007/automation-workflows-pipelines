# 01 AI Lead Research Agent

# Anthropic API key. Both model calls use claude-opus-5.

# LLM via the 9router gateway (OpenAI-compatible: /v1/chat/completions, Bearer auth).
# Only modelark/seed-2-0-pro-260328 responds on this key - every Claude route on the
# router returns 403 (Cloudflare) or 402 (no credits). Verified 2026-08-20.
LLM_BASE_URL=https://llm.acme.example
LLM_API_KEY=
LLM_MODEL=modelark/seed-2-0-pro-260328
LLM_MODEL_WRITER=modelark/seed-2-0-pro-260328

# Optional. Sheet that receives researched records. Delete the Sheets node if unused.
LEADS_SHEET_ID=

# Optional. Records below this fit score route to STOP: low fit. Default 40.
MIN_FIT_SCORE=40

# Optional. Default ICP used when the caller does not pass icp_description in the body.
ICP_DESCRIPTION=SME with a repetitive operations process, one clear decision maker, and budget for a paid tool.
