# 12 Cold Email Sequencer - GCC volume build
# Brief: 14,000 verified emails/month, 20+ qualified calls/month, GCC decision makers.

# ---- the contract numbers -------------------------------------------------
MONTHLY_TARGET=14000
WORKING_DAYS_PER_MONTH=22
SEND_SLOTS_PER_DAY=9

# ---- safety interlocks (the workflow refuses to run without these) --------
# True only when EVERY sending domain has SPF, DKIM, DMARC verified and warmup
# finished. None of them may be the client's primary domain.
SENDING_DOMAINS_VERIFIED=false

# review = park drafts in the Drafts tab. auto = queue for sending.
# Every new client starts on review, for at least two weeks.
APPROVAL_MODE=review

# ---- warmup ramp ----------------------------------------------------------
# Working day number since go-live. <=5 sends 25% of target, <=10 50%, <=15 75%,
# then full. Set high (999) once past week four.
RAMP_DAY=1

# ---- mailboxes ------------------------------------------------------------
# 636/day at 35 per mailbox needs ~18 warmed mailboxes across ~6 domains.
# The Mailboxes tab is the source of truth; this is the default cap per box.
PER_MAILBOX_DAILY_CAP=35

# ---- per-subject statutory ceilings ---------------------------------------
# Singapore's Spam Control Act counts PER SUBJECT LINE: 100/24h, 1,000/30d,
# 10,000/year. These sit slightly under the legal line as headroom.
SUBJECT_CAP_24H=90
SUBJECT_CAP_30D=900
SUBJECT_CAP_YEAR=9000

# ---- sequences ------------------------------------------------------------
# 3-5 sequences, each with subject variants. At 14k/month you need 17+ variants
# in total or the allocator refuses to start. Keep them genuinely different -
# near-identical subjects defeat the point.
SEQUENCES_JSON=[{"id":"ops-cost","angle":"manual process costing headcount","subjects":["quick question about {company}","{company} + one process","re: your ops setup","worth 10 minutes?","{first_name} - one question"]},{"id":"growth","angle":"scaling without adding admin staff","subjects":["scaling {company} without more admin","the {company} bottleneck","adding headcount or adding tooling?","one thing before you hire","{first_name}, about growth"]},{"id":"integration","angle":"systems that do not talk to each other","subjects":["two systems, one team","{company} and double entry","how many systems?","re: your stack","the copy-paste problem"]},{"id":"proof","angle":"what a similar company did","subjects":["a company like {company}","what worked next door","{first_name} - a short case","similar setup, different result"]}]

# Leads below this enrichment confidence are never sent to
MIN_CONFIDENCE=70

# ---- seasonal -------------------------------------------------------------
# Set true across Ramadan and Eid. Response rates collapse and sending through
# it reads badly.
SEASONAL_PAUSE=false
SEASONAL_PAUSE_REASON=Ramadan

# ---- model ----------------------------------------------------------------
LLM_BASE_URL=https://llm.acme.example
LLM_API_KEY=
LLM_MODEL=modelark/seed-2-0-pro-260328
LLM_MODEL_WRITER=modelark/seed-2-0-pro-260328

# ---- sending tool ---------------------------------------------------------
# One Instantly campaign per sequence id, so A/B and per-sequence stats stay clean.
INSTANTLY_API_KEY=

# ---- sheet and alerts -----------------------------------------------------
# Tabs required: Leads, Suppression, Drafts, Mailboxes, SendLedger
LEADS_SHEET_ID=
ALERT_WEBHOOK_URL=

# Post a slot summary only when something needs a decision. Nine "all good"
# messages a day is how a channel gets muted.
QUIET_SLOTS=true

# ---- copy -----------------------------------------------------------------
SENDER_INTRO=a small automation studio that builds internal tools for SMEs
SENDER_SIGNATURE=Operator, Acme
