    {
      "id": "b6c5b20e-b4da-49ae-afe9-7fe9584db6c5",
      "name": "Load sample attendee list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Used until ATTENDEES_SHEET_ID is set: 40 tickets, 24 already checked in.\nconst types = ['General', 'General', 'General', 'Speaker', 'Sponsor'];\nconst names = ['Alma Price', 'Ben Cho', 'Cora Diaz', 'Dev Patel', 'Eli Grant', 'Fay Moss', 'Gus Lind', 'Hana Ito'];\nreturn Array.from({ length: 40 }, (_, i) => ({ json: {\n  ticket_code: 'TIX-' + String(i + 1).padStart(4, '0'), name: names[i % names.length] + ' ' + (i + 1), ticket_type: types[i % types.length],\n  checked_in_at: i < 24 ? new Date(Date.now() - (60 - i) * 60e3).toISOString() : '' } }));\n"
      },
      "position": [
        1616,
        352
      ]
    },
    {
      "id": "d468eee9-9788-4019-a35f-135f23a4d468",
      "name": "Combine attendee sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "parameters": {
        "numberInputs": 2
      },
      "position": [
