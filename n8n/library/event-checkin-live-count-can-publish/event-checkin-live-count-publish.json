    {
      "id": "c0aaf506-5c4d-4f26-a315-6315dd95c0aa",
      "name": "Write the milestone post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Count, share of the list and per ticket type. Only built on a milestone.\nconst cfg = $('config').first().json;\nconst v = $('Validate the ticket').first().json;\nconst pct = Math.round(v.count / v.total * 100);\nconst types = Object.entries(v.totals_by_type).map(([t, n]) => t + ' ' + (v.by_type[t] || 0) + '/' + n).join(', ');\nconst head = v.count === v.total ? 'Everyone is in' : v.count + ' checked in';\nconst text = (cfg.mode === 'test' ? '[TEST] ' : '') + '*' + cfg.event_name + ': ' + head + '* (' + v.count + '/' + v.total + ', ' + pct + '%)\\n' + types + '\\nLatest: ' + v.name + (v.gate ? ' at ' + v.gate : '');\nreturn [{ json: { text, milestone: v.milestone } }];\n"
      },
      "position": [
