# 07 CRM Data Hygiene

# Sheet with the Leads, Data Quality and Suppression tabs.
# Leave it empty and the sheet-setup flow creates the spreadsheet, then prints the id
# to paste back in here.
LEADS_SHEET_ID=

# Names the spreadsheet if the setup flow has to create it. Ignored otherwise.
LEADS_SHEET_TITLE=Lead Data

# Used to recheck addresses that have gone stale
VERIFIER_API_KEY=

# An address older than this gets rechecked
REVERIFY_AFTER_DAYS=90

# How many to recheck per weekly run. 50 costs about US$0.20.
REVERIFY_BATCH=50

# Where the weekly report goes
ALERT_WEBHOOK_URL=
