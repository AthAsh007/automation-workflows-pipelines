    {
      "parameters": {
        "jsCode": "const body = $(\"Webhook Event\").first().json.body;\n\ntry {\n  const requiredFields = [\n    \"firstName\",\n    \"lastName\",\n    \"emailAddress\",\n    \"organization\",\n    \"jobTitle\",\n    \"cityAndState\",\n  ];\n\n  // Check required fields\n  for (const field of requiredFields) {\n    if (\n      body?.[field] === undefined ||\n      body?.[field] === null ||\n      body?.[field] === \"\"\n    ) {\n      throw new Error(`${field} is required`);\n    }\n\n    // Must be string\n    if (typeof body?.[field] !== \"string\") {\n      throw new Error(`${field} must be a string`);\n    }\n\n    // Don't allow whitespace-only strings\n    if (body?.[field].trim() === \"\") {\n      throw new Error(`${field} cannot be empty`);\n    }\n  }\n\n  // Validate email\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!emailRegex.test(body.emailAddress.trim())) {\n    throw new Error(\"emailAddress must be a valid email address\");\n  }\n\n  return {\n    valid: true,\n  };\n\n} catch (e) {\n  return {\n    valid: false,\n    message: e.message,\n  };\n}"
      },
