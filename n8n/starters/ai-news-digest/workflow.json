    {
      "parameters": {
        "jsCode": "let results = [];\n\nfor (const value of $(\"Filter the news\").all()) {\n  const items = value.json.output.items.flatMap(item => {\n    const findRSS = $(\"Merge RSS\").all().find(f => f?.json?.guid === item?.guid)?.json || null;\n\n    if (!findRSS) return [];\n    \n    return {\n      ...item,\n      ...findRSS,\n    }\n  });\n\n  results = [\n    ...results,\n    ...items,\n  ]\n}\n\nreturn results;"
      },
