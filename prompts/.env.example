# Any OpenAI-compatible endpoint. All of these work:
#   Ollama          http://localhost:11434/v1     LLM_API_KEY=ollama
#   llama.cpp       http://localhost:8080/v1      LLM_API_KEY=none
#   vLLM            http://localhost:8000/v1      LLM_API_KEY=none
#   A hosted provider: whatever base URL and key it gives you
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# The model used for classification, extraction and routing. Needs to be
# reasonable at JSON. A 7B instruct model is usually enough with the repair loop.
LLM_MODEL=qwen2.5:7b-instruct

# A larger model for review and for generating prompt variants. Optional:
# leave blank and LLM_MODEL is used for everything.
LLM_MODEL_LARGE=

# Seconds before a single call is abandoned.
LLM_TIMEOUT=60

# Hard ceiling on calls per pipeline run. A runaway loop stops here.
LLM_MAX_CALLS=200
